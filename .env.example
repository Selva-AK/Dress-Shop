# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/dress-store
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/dress-store

# JWT Secret (generate a random string for production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Vercel Blob Storage Token
# Get this from: https://vercel.com/dashboard/stores
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=DressStore

# Admin Default Credentials (Optional - for first-time setup)
ADMIN_EMAIL=admin@dressstore.com
ADMIN_PASSWORD=Admin@12345
